eal ni aptitud para consumo."]]};function missionInfo(e){const a=learningMission(state,e);return{...a,lesson:missionLessons[e][a.index],name:species[e].name}}function sessionDuration(){return state.mode==="deepen"?"10–20 min":"5–10 min"}function missionLabel(e){const a=missionInfo(e);return a.finished?"Recorrido completo":a.pending?`Misión ${a.index+1} lista · repasar y pausar`:`Misión ${a.index+1} de 3 · ${a.completed}/${a.total} etapas`}function sessionBar(e){const a=missionInfo(e);return`<div class="session-guide"><span>MISIÓN ${a.index+1} DE 3 · ${a.completed}/${a.total} ETAPAS</span><strong>${a.lesson[0]}</strong><p>${a.lesson[1]}</p><small>Estimación: ${sessionDuration()}. Puedes parar antes.</small></div>`}function offscreenTask(e){return["bovine","pig","poultry"].includes(e)?"Fuera de pantalla, dibuja dos columnas: “lo que vi” y “lo que falta saber”. Usa una ilustración impresa de un animal y escribe o di un ejemplo en cada columna. Los menores lo hacen con una persona adulta. No hace falta visitar, tocar ni alimentar animales.":"Fuera de pantalla, observa una planta desde un lugar seguro o usa una ilustración impresa. Dibuja una hoja y explica una cosa que ves y otra que todavía no sabes. Los menores lo hacen con una persona adulta; sin recoger, tocar ni probar plantas."}function checkpointMarkup(e){const a=missionInfo(e),s=e==="cilantro"?'<button class="text-button" data-reset>Sembrar otra vez</button>':`<button class="text-button" data-module="${e}" data-module-action="replay">Volver a practicar este recorrido</button>`,o=a.finished?`<button class="text-button" data-page="cuaderno">Ver lo aprendido en mi cuaderno →</button>${s}`:`<button class="text-button" data-session-action="continue" data-session-id="${e}">Elegir seguir con la misión ${a.index+2} →</button>`;return`${playModeMarkup()}<section class="session-recap" aria-label="Cierre de misión"><span class="session-eyebrow">MISIÓN ${a.index+1} DE 3 · ${a.total} ETAPAS COMPLETADAS</span><h3 tabindex="-1">Un buen momento para parar.</h3><h4>${a.lesson[0]}</h4><p>${a.lesson[2]}</p><p class="session-save" role="status">${saveWorks?"Tu avance está guardado en este navegador.":"No se pudo guardar aquí. Descarga una copia antes de cerrar."}</p><button class="primary" data-session-action="finish" data-session-id="${e}">Terminar por ahora${icon("check")}</button>${o}<div class="recall-check"><strong>Sin mirar la respuesta</strong><p>${a.lesson[3]}</p><details><summary>Comparar mi explicación</summary><p>${a.lesson[4]}</p><small>Autoevaluación sin nota. No necesitas responder en voz alta ni escribir aquí.</small></details></div>${state.mode==="deepen"?transferMarkup(e,a.index):""}<details class="offscreen-task"><summary>Una observación fuera de pantalla</summary><p>${offscreenTask(e)}</p><small>Opcional. No se entrega ni se califica.</small></details></section>`}function renderSession(e){const a=missionInfo(e),s=$(e==="cilantro"?"mission-content":"module-task");a.pending?(s.innerHTML=checkpointMarkup(e),e!=="cilantro"&&($("module-scene").innerHTML=speciesArt(e)+`<p class="scene-instruction">Punto de pausa · misión ${a.index+1} completada</p>`)):a.finished||s.insertAdjacentHTML("afterbegin",sessionBar(e)),e==="cilantro"&&($("garden-action").disabled=a.pending,document.querySelectorAll(".tool").forEach(r=>{r.disabled=a.pending}),$("step-count").textContent=a.pending?`Misión ${a.index+1} lista`:`${Math.min(a.step+1,7)} de 7`);const o=$(e==="cilantro"?"huerto-page":"module-page");o.dataset.checkpoint=String(a.pending)}function sessionIsWaiting(e){return learningMission(state,e)?.pending===!0}function focusSession(e){const a=$(e==="cilantro"?"mission":"module-task");a.scrollTop=0,sessionIsWaiting(e)&&a.querySelector(".session-recap h3")?.focus({preventScroll:!0})}function showSessionPause(e){save();const a=missionInfo(e);$("pause-copy").innerHTML=`<span class="session-eyebrow">${a.name} · MISIÓN ${a.index+1} DE 3</span><p>${a.pending?"Ya completaste esta misión.":`Llevas ${a.co