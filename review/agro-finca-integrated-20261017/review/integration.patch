odule])}const depthPrompts={cilantro:[["¿Soltar tierra basta?","No. Revisa también por dónde sale el exceso de agua."],["¿Qué sabes de la semilla?","Identidad e indicaciones de su variedad."],["¿Regar suave significa regar siempre?","No. Decide según la humedad observada."],["¿El juego mide días reales?","No. Solo representa etapas de desarrollo."],["¿Cuándo revisarías la espera?","Si cambian humedad, clima o estado de la planta."],["¿Hojas y semillas se cosechan igual?","No. El destino cambia la etapa necesaria."],["¿Tres manojos son tres kilos?","No. Para conocer el peso falta medirlo."],["¿Qué mediste realmente?","Contaste manojos ficticios, sin medir días ni kilos."]],maize:[["¿Basta el aspecto de la semilla?","No. Importan variedad, destino y ambiente."],["¿Más agua siempre es mejor?","No. El exceso necesita una salida."],["¿Por qué formar un bloque?","Varias hileras representan el encuentro del polen."],["¿Un brote ya produce grano?","No. Faltan crecimiento, floración y desarrollo."],["¿Una hoja basta para diagnosticar?","No. Registra el cambio y solicita revisión."],["¿Qué conecta panoja y barbas?","El viento transporta el polen."],["¿Flores significa grano listo?","No. Faltan desarrollo y revisión de madurez."],["¿Por qué identificar el lote?","Para relacionarlo con sus observaciones."],["¿Seis plantas garantizan seis kilos?","No. El esquema no mide producción."],["¿Cómo pasarías a un lote real?","Con observaciones locales y orientación competente."]],tomato:[["¿Todos los tomates son iguales?","No. Esta variedad ficticia es solo un ejemplo."],["¿Por qué dejar salir agua?","El exceso cambia las condiciones de germinación."],["¿Basta el reloj para trasplantar?","No. Observa desarrollo y adaptación al sitio."],["¿Por qué no apretar el tallo?","El soporte debe acompañar su crecimiento."],["¿Flores justifican cosechar?","No. Todavía faltan frutos desarrollados."],["¿El color rojo basta siempre?","No. Contrasta variedad y destino."],["¿Por qué dejar algunos frutos?","Los que no están listos siguen en desarrollo."],["¿Qué falta tras contar frutos?","Medir el peso; contar no equivale a pesar."],["¿Qué revisar en otra variedad?","Sus características y las condiciones locales."]],bovine:[["¿Por qué anotar identidad y etapa?","Para seguir al animal e interpretar sus necesidades."],["¿Observar equivale a diagnosticar?","No. Registra hechos para la persona responsable."],["¿Por qué seguir la transición?","Cambian necesidades, adaptación y recursos."],["¿Sabes cuánto lleva vacío?","No. La escena muestra su estado, no su duración."],["¿Por qué avisar desde fuera?","El responsable puede evaluar y actuar con seguridad."],["¿Todo bovino produce leche?","No. La lactación corresponde a una etapa biológica."],["¿Puedes deducir litros del rebaño?","No. Anota «sin medir» si no hay una medición."],["¿Bebedero vacío es un diagnóstico?","No. Es un hecho; una enfermedad requiere evaluación."],["¿Cómo dar seguimiento sin inventar?","Pide revisión y registro de lo comprobado."]],pig:[["¿Por qué conocer origen y etapa?","Para planificar identificación y bioseguridad."],["¿Observar autoriza a intervenir?","No. Comunica hechos a la persona competente."],["¿Qué revisar en la transición?","Adaptación al ambiente y a la alimentación."],["¿Refugio sustituye al agua?","No. Los recursos cumplen funciones distintas."],["¿Hozar es siempre un problema?","No. Explorar es un comportamiento normal."],["¿El dibujo permite saber el peso?","No. Hace falta una medición adecuada."],["¿Por qué registrar el destino?","Para vincular el lote con su salida y revisión."],["¿El plano certifica buena salud?","No. No sustituye evaluación veterinaria."],["¿Qué no produjo el juego?","Pesos medidos, evaluación de salud ni salida real."]],poultry:[["¿Por qué aclarar «postura»?","El objetivo distingue este ciclo de otras crianzas."],["¿Parecer sana descarta gérmenes?","No. Sigue las reglas de visita e higiene."],["¿Por qué revisar según la etapa?","Las necesidades cambian con el desarrollo."],["¿Avanzar el reloj garantiza huevos?","No. Importan desarrollo y condiciones."],["¿Huevos prueban bienestar completo?","No. Los recursos siguen necesitando revisión."],["¿Cómo evitar un conteo doble?","Marca cada huevo una vez y distingue las piedras."],["¿Contar certifica inocuidad?","No. La aptitud de consumo requiere otra revisión."],["¿Por qué registrar en huevos?","Contaste unidades, sin medir peso."],["¿Qué no prueban cuatro huevos?","Producción real ni seguridad para el consumo."]]};function depthMarkup(e,a,s){if(state.mode!=="deepen")return"";const[o,r]=depthPrompts[e][a];return`<section class="deeper depth-study" aria-label="Profundizar: razonamiento de esta etapa"><strong>🔎 Profundizar · comprende la decisión</strong><p>${s}</p><h4>🧠 Antes de seguir, razona</h4><p>${o}</p><details class="depth-answer"><summary>Comparar mi razonamiento</summary><p>${r}</p><small>Autoevaluación opcional, sin nota. Tu avance se conserva.</small></details></section>`}function renderMode(){const e=state.mode==="deepen";$("learning-mode").dataset.mode=state.mode,$("mode-title").textContent=e?"🔎 Profundizar: entiende el porqué":"🌱 Explorar: aprende paso a paso",$("mode-copy").textContent=e?"Razona en cada etapa y compara tu explicación. En las pausas, prueba una decisión ante otra escena. Puedes seguir donde ibas.":"Observa la escena, sigue una instrucción breve y prueba tu decisión. Las pistas están disponibles cuando las necesites.",$("mode-example").innerHTML=e?"<strong>🧠 Un ejemplo para empezar</strong><p>Contar tres manojos no dice cuántos kilos pesan. ¿Qué falta para saberlo?</p><details><summary>Comparar mi razonamiento</summary><p>Falta medir el peso con una balanza. Un conteo y un peso expresan datos diferentes.</p></details>":"",$("mode-example").hidden=!e}function playModeMarkup(){return`<div class="play-mode"><div class="mode-switch" role="group" aria-label="Nivel de detalle de esta actividad">${["explore","deepen"].map(e=>`<button data-play-mode="${e}" 