{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "venezuelaagro-staging",
  "account_id": "5ce31d22b086645c67dab913699edd3f",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-14",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "keep_vars": true,
  "assets": {"binding": "ASSETS", "run_worker_first": true},
  "d1_databases": [{
    "binding": "DB",
    "database_name": "venezuelaagro-staging",
    "database_id": "95ad0e14-ad7f-4385-bb4e-a869197d30c7",
    "migrations_dir": "drizzle"
  }],
  "r2_buckets": [{"binding": "BUCKET", "bucket_name": "venezuelaagro-staging-files"}],
  "vars": {
    "AUTH_MODE": "google",
    "AUTH_ACCESS_POLICY": "private-staging",
    "APP_ORIGIN": "https://venezuelaagro-staging.alvarojuniorcarrerovasquez.workers.dev",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFWfwMwzdORVkoDe"
  }
  // GOOGLE_CLIENT_ID and STAGING_ALLOWED_EMAILS must be supplied deliberately.
  // GOOGLE_CLIENT_SECRET, AUTH_SESSION_SECRET, TURNSTILE_SECRET_KEY are Worker secrets.
  // Missing values deliberately disable standalone authentication. Do not copy secrets here.
}
