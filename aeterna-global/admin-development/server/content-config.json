{
  "brand": "aeterna",
  "name": "Aeterna Global",
  "color": "#a32626",
  "font": "Arial, sans-serif",
  "adminEnv": "AETERNA_ADMIN_USER_IDS",
  "fields": [
    {
      "key": "seoTitle",
      "label": "Título SEO",
      "kind": "text",
      "original": "<title>Aeterna Global | Content, Photography & Social Media — Gold Coast</title>",
      "default": "Aeterna Global | Content, Photography & Social Media — Gold Coast",
      "max": 160
    },
    {
      "key": "seoDescription",
      "label": "Descripción SEO",
      "kind": "meta",
      "original": "<meta name=\"description\" content=\"Aeterna Global on the Gold Coast: advertising, web development, organic SEO, social media management, video production, photography, rebranding, logo design, process automation and menu design.\">",
      "default": "Aeterna Global on the Gold Coast: advertising, web development, organic SEO, social media management, video production, photography, rebranding, logo design, process automation and menu design.",
      "max": 500
    },
    {
      "key": "socialTitle",
      "label": "Título al compartir",
      "kind": "meta",
      "original": "<meta property=\"og:title\" content=\"Aeterna Global — Creative content. Meaningful moments.\">",
      "default": "Aeterna Global — Creative content. Meaningful moments.",
      "max": 500
    },
    {
      "key": "socialDescription",
      "label": "Descripción al compartir",
      "kind": "meta",
      "original": "<meta property=\"og:description\" content=\"Content, photography and digital strategy for Gold Coast businesses, events and families.\">",
      "default": "Content, photography and digital strategy for Gold Coast businesses, events and families.",
      "max": 500
    },
    {
      "key": "heroTitle",
      "label": "Presentación · título",
      "kind": "text",
      "original": "<h1>Make your brand<br>worth noticing.<br><span>Capture what<br>matters.</span></h1>",
      "default": "Make your brand\nworth noticing.\nCapture what\nmatters.",
      "max": 1000
    },
    {
      "key": "heroBody",
      "label": "Presentación · texto",
      "kind": "text",
      "original": "<p>Creative content, photography and social media management for businesses. Thoughtful coverage for events and life’s meaningful moments.</p>",
      "default": "Creative content, photography and social media management for businesses. Thoughtful coverage for events and life’s meaningful moments.",
      "max": 1000
    },
    {
      "key": "servicesTitle",
      "label": "Servicios · título",
      "kind": "text",
      "original": "<h2>Made for your business.<br>Made for your story.</h2>",
      "default": "Made for your business.\nMade for your story.",
      "max": 1000
    },
    {
      "key": "servicesBody",
      "label": "Servicios · texto",
      "kind": "text",
      "original": "<p>Choose a focused service or bring production and strategy together.</p>",
      "default": "Choose a focused service or bring production and strategy together.",
      "max": 1000
    },
    {
      "key": "aboutTitle",
      "label": "Nosotros · título",
      "kind": "text",
      "original": "<h2>One team. One strategy.<br>Unlimited growth.</h2>",
      "default": "One team. One strategy.\nUnlimited growth.",
      "max": 1000
    },
    {
      "key": "featureImage",
      "label": "Imagen de presentación",
      "kind": "image",
      "original": "<img src=\"assets/camera.jpg\" alt=\"Álvaro con su cámara, fotografía original proporcionada\" width=\"608\" height=\"975\">",
      "default": "assets/camera.jpg",
      "max": 300
    },
    {
      "key": "featureImageAlt",
      "label": "Descripción de la imagen",
      "kind": "alt",
      "original": "<img src=\"assets/camera.jpg\" alt=\"Álvaro con su cámara, fotografía original proporcionada\" width=\"608\" height=\"975\">",
      "default": "Álvaro con su cámara, fotografía original proporcionada",
      "max": 500
    }
  ],
